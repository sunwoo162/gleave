{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eeee.local/contracts/qa-report.v1.schema.json",
  "title": "ISEOL Independent QA Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "projectId", "projectRevision", "status", "independent", "executor", "checks", "findings", "evidenceIds", "createdAt"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "projectId": { "type": "string", "minLength": 1 },
    "projectRevision": { "type": "string", "minLength": 1 },
    "status": { "enum": ["PASS", "WARN", "FAIL"] },
    "independent": { "const": true },
    "executor": { "const": "iseol-independent-qa" },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "status", "summary", "evidenceIds"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "status": { "enum": ["PASS", "WARN", "FAIL"] },
          "summary": { "type": "string", "minLength": 1 },
          "evidenceIds": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["checkId", "severity", "summary", "evidenceIds"],
        "properties": {
          "checkId": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["WARN", "FAIL"] },
          "summary": { "type": "string", "minLength": 1 },
          "evidenceIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "evidenceIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "createdAt": { "type": "string", "format": "date-time" }
  }
}
