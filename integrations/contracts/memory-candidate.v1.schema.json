{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eeee://contracts/memory-candidate/v1",
  "title": "MemoryCandidateV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "candidateId", "kind", "content", "scope", "sourceProjectId", "sourceArtifactIds", "evidenceIds", "verificationIds", "confidence", "promotionState", "createdAt"],
  "properties": {
    "schemaVersion": {"const": 1},
    "candidateId": {"type": "string", "minLength": 1},
    "kind": {"enum": ["success_pattern", "failure_pattern", "qa_rule", "regression_rule", "agent_routing_hint", "playbook"]},
    "content": {"type": "string", "minLength": 1},
    "scope": {"type": "object"},
    "sourceProjectId": {"type": "string", "minLength": 1},
    "sourceArtifactIds": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "evidenceIds": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "verificationIds": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "promotionState": {"enum": ["candidate", "active", "superseded", "revoked"]},
    "createdAt": {"type": "string", "format": "date-time"}
  }
}
