{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eeee://contracts/project-outcome-report/v1",
  "title": "ProjectOutcomeReportV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "projectId", "requestId", "projectRevision", "status", "artifacts", "agentTeams", "handoffs", "deterministicVerification", "qaReport", "claimLatchReports", "receipts", "risks", "memoryCandidates", "createdAt"],
  "properties": {
    "schemaVersion": {"const": 1},
    "projectId": {"type": "string", "minLength": 1},
    "requestId": {"type": "string", "minLength": 1},
    "projectRevision": {"type": "string", "minLength": 1},
    "status": {"enum": ["planned", "running", "completed", "blocked", "failed", "cancelled"]},
    "artifacts": {"type": "array", "items": {"type": "object"}},
    "agentTeams": {"type": "array", "items": {"type": "object"}},
    "handoffs": {"type": "array", "items": {"type": "object"}},
    "deterministicVerification": {"type": "object"},
    "qaReport": {"type": "object"},
    "claimLatchReports": {"type": "array", "items": {"type": "object"}},
    "receipts": {"type": "array", "items": {"type": "object"}},
    "risks": {"type": "array", "items": {"type": "object"}},
    "memoryCandidates": {"type": "array", "items": {"type": "object"}},
    "createdAt": {"type": "string", "format": "date-time"}
  }
}
