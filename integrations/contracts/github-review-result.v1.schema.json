{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gleave.local/contracts/github-review-result.v1.schema.json",
  "title": "Gleave GitHub review result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "projectId", "projectRevision", "repository", "pullNumber", "headSha", "reviewStatus", "findingsCount", "checks", "source", "generatedAt"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "projectId": { "type": "string", "minLength": 1 },
    "projectRevision": { "type": "string", "minLength": 1 },
    "repository": { "type": "string", "minLength": 3 },
    "pullNumber": { "type": "integer", "minimum": 1 },
    "headSha": { "type": "string", "minLength": 7 },
    "reviewStatus": { "enum": ["passed", "warned", "failed"] },
    "findingsCount": { "type": "integer", "minimum": 0 },
    "checks": { "type": "array", "items": { "type": "object" } },
    "source": { "const": "iseol-github-review" },
    "generatedAt": { "type": "string", "format": "date-time" }
  }
}
